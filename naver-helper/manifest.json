{
  "manifest_version": 3,
  "name": "WHENG Naver Blog Helper",
  "version": "1.2.0",
  "description": "WHENG 시공사례의 제목, 본문, 사이트 링크, 시공사진을 네이버 블로그 글쓰기 화면에 불러옵니다.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://wheng.onrender.com/*",
    "https://blog.naver.com/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wheng.onrender.com/*",
        "https://blog.naver.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}